# Canvas MCP v1 self-host configuration. Keep .env private (chmod 600).
# A fresh v1 database is required; pre-v1 databases are deliberately refused.
# Choose a reviewed v1 tag/digest. For a source build use canvas-mcp:selfhost-v1-local.
CANVAS_MCP_IMAGE=
MCP_AUTH_MODE=selfhost

# Required: public HTTPS origin, no path, query or trailing slash.
# It is the local OAuth issuer and MCP resource origin, e.g. https://mcp.example.com.
PUBLIC_BASE_URL=

# Login providers and credentials are configured in /account/setup and Admin > Settings.
# Entra, Google, GitHub and OIDC registrations are database-owned; no provider
# credential, button order or enablement belongs in the normal environment.
# MCP_SCOPE=Canvas.Access

# Optional admission policy for database-configured providers. Email-based
# automatic linking is unavailable; identity linking is explicit in /account.
# ACCESS_POLICY=rules
# ACCESS_RULES=entra:role:Canvas.User
# ACCESS_FALLBACK=deny
# OWNER_RULES=entra:role:Canvas.Owner
# SELFHOST_BOOTSTRAP_OWNER=entra:<tenant-guid>:<object-guid>
# ACCOUNT_LINK_BY_VERIFIED_EMAIL=false

# Button names are managed in Admin > Settings, rather than environment variables.

# Generate once with openssl rand -base64 32. Keep keys with database backups.
# JWT signing keys derive from this ordered keyring; first key is active.
# Rotation: add a new key first, keep old keys, run token_admin rotate, then
# verify clients/references before removing an old key. Never regenerate in place.
CANVAS_TOKEN_KEYS=
# Generate separately with openssl rand -base64 32.
ACCOUNT_SESSION_SECRET=
# ACCOUNT_SESSION_TTL_SECONDS=900
# ACCESS_TOKEN_TTL=1h
# REFRESH_ABSOLUTE_TTL=30d
# REFRESH_REUSE_GRACE_S=30
# MAX_UPSTREAM_AUTH_AGE=14d
# CIMD_ENABLED=true
# CIMD_FETCH_TIMEOUT_S=3
# CIMD_STALE_MAX=7d
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost/callback,http://127.0.0.1/callback

# Every account selects an explicit Canvas school and acknowledges token custody.
# New database: no featured school, directory search enabled. Manage both under
# Admin > Settings or token_admin schools/settings. Search terms go to Instructure.
# Private-address school exceptions are operator CLI only. No server Canvas token.
CANVAS_ROLE=student
TIMEZONE=America/Los_Angeles
MCP_MAX_RESULT_CHARS=140000
# Request-local course data is the default; per_principal is an explicit cache opt-in.
# SELFHOST_COURSE_STATE=request_local
# SELFHOST_DISABLED_TOOLS=read_course_file_text
# Optional constrained pilot: see README before enabling; configure exactly one
# featured school and directory search off in the database first.
# SELFHOST_PROFILE=pilot

# Write tools are absent by default. These form the operator ceiling; each user
# must also enable individual tools and each course may still refuse them.
# Preview/confirmation tools still require the user's explicit approval to write.
# ALLOWED_WRITE_TOOLS=all
# STUDENT_WRITE_TOOLS=submit_assignment,comment_on_my_submission,mark_module_item_done,create_planner_note,update_planner_note,delete_planner_note,mark_planner_item_complete,create_personal_calendar_event,delete_personal_calendar_event,send_message,reply_to_conversation
# COURSE_AGENT_POLICY_DEFAULT=allow
# ENABLE_DATA_ANONYMIZATION=true
# LOG_ACCESS_EVENTS=true
# AUDIT_LOG_DIR=/data/audit

# The image supplies these defaults. React is mandatory and checked at startup.
# SELFHOST_DATA_DIR=/data
# ACCOUNT_WEB_DIST=/app/web-dist
# SQLite default: /data/canvas-mcp/tokens.sqlite3. All account/protocol state is SQL.
# Use the PostgreSQL compose override or your managed PG service:
# DATABASE_URL=postgresql+psycopg://canvas:<percent-encoded-password>@postgres:5432/canvas_mcp
# POSTGRES_PASSWORD=
# Automatic compatible schema upgrades are on by default.
# DATABASE_AUTO_MIGRATE=true
# DATABASE_ALLOW_SQLITE_OUTSIDE_DATA_DIR=false
# Upgrade/backup/import tooling is isolated in src/canvas_mcp/core/selfhost/db/migrations/.
# Do not merely switch DATABASE_URL on an enrolled SQLite deployment: follow that
# package's transfer guide with the server stopped. Keyrings must match the source.
# Reserved: redis is refused; one process/replica only.
# SELFHOST_STATE_BACKEND=memory
# Reserved: trusted proxy CIDRs are not implemented and must remain unset.
# TRUSTED_PROXY_CIDRS=

# These upstream-mode settings must stay unset in selfhost mode:
# CANVAS_API_TOKEN, MCP_ACCESS_KEYS, ENTRA_AUTH_ENABLED, MCP_ALLOW_UNAUTHENTICATED,
# ACCESS_REQUEST_ENABLED, FASTMCP_SSRF_TRUST_PROXY. Code execution is unavailable.
# For deliberately public open admission, the explicit acknowledgement is required:
# ACCESS_OPEN_ACKNOWLEDGE_PUBLIC=false
