# canvas-mcp 自托管（Entra 多用户）配置模板。
#
#   curl -fsSL https://raw.githubusercontent.com/KKazuhaK/canvas-mcp/uci-student/deploy/selfhost/env.example -o .env
#   chmod 600 .env        # 含密钥，务必只让自己可读；绝不要提交到 git
#
# 标记「必填」的项必须填写，缺一个或格式不对，服务会拒绝启动（fail closed）。
# 值不要加引号，等号两边不要有空格，同一行不要写行尾注释。
# 随机密钥的生成命令写在各项旁边（openssl rand -base64 48 / 32）。

# ---------------------------------------------------------------------------
# 模式开关
# ---------------------------------------------------------------------------

# 必填。固定写 entra-oauth 才会启用多用户模式（不设置则是旧的单用户行为）。
MCP_AUTH_MODE=entra-oauth

# 必填。服务的公网地址：https，不带路径、查询串、末尾斜杠。
# 它同时是 OAuth issuer、MCP 资源（<地址>/mcp）以及唯一被放行的 Host / Origin。
PUBLIC_BASE_URL=https://canvas.mcp.kazuhahub.com

# ---------------------------------------------------------------------------
# Microsoft Entra ID（Azure AD）：同一个应用同时用于 MCP 登录和 /account 登录
# ---------------------------------------------------------------------------

# 必填。目录（租户）ID，GUID。不能写 common / organizations / consumers。
ENTRA_TENANT_ID=

# 必填。应用程序（客户端）ID，GUID。
ENTRA_CLIENT_ID=

# 必填。客户端密码的「值」（不是「密码 ID」），至少 16 个字符。
# 到期后要在 Entra 里新建并替换，只需重启，不影响用户。
ENTRA_CLIENT_SECRET=

# 在「公开 API」里创建的委托范围名称（api://<客户端ID>/Canvas.Access）。默认即可。
# ENTRA_API_SCOPE=Canvas.Access

# 授予访问权的应用角色：分配给受信任的用户组。默认即可。
# ENTRA_REQUIRED_ROLE=Canvas.User

# 运维者角色：同样有访问权，并可打开 /account/admin 查看、撤销登记。必须与上面不同。
# ENTRA_OWNER_ROLE=Canvas.Owner

# MCP 客户端（claude.ai、Claude Code）允许使用的回调地址，逗号分隔。默认值如下，
# 一般不用改：https 地址（非本机），或 http 的 localhost / 127.0.0.1（不写端口，任意端口都匹配）。
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost/callback,http://127.0.0.1/callback

# ---------------------------------------------------------------------------
# 密钥（全部必须是随机生成的，不要复用）
# ---------------------------------------------------------------------------

# 必填。签发给 claude.ai / Claude Code 的令牌所用的签名密钥，至少 32 个字符。
# 生成：openssl rand -base64 48
# 更换后所有 MCP 客户端都需要重新连接。
OAUTH_JWT_SIGNING_KEY=

# 必填。/account 会话 Cookie 的加密密钥，base64，解码后至少 32 字节。
# 生成：openssl rand -base64 32
# 更换后只会让 /account 的登录会话失效。
ACCOUNT_SESSION_SECRET=

# /account 登录会话的绝对有效期（秒），60 到 3600，默认 900（15 分钟），不会自动续期。
# ACCOUNT_SESSION_TTL_SECONDS=900

# 必填。加密 Canvas token 的密钥环：kid:base64密钥[,kid2:base64密钥]。
# kid 只能含字母、数字、下划线、连字符（最长 32 位）；每个密钥解码后恰好 32 字节。
# 第一项用于加密新数据，所有项都可解密。生成：
#   echo "k1:$(openssl rand -base64 32)"
# 丢失它 = 所有用户需要重新登记 Canvas token。轮换步骤见 README.md。
CANVAS_TOKEN_KEYS=

# ---------------------------------------------------------------------------
# Canvas
# ---------------------------------------------------------------------------

# 必填。固定的 Canvas 地址，必须是 https。所有用户都只能访问这一个 Canvas。
CANVAS_API_URL=https://canvas.eee.uci.edu

# 工具集：学生账号推荐 student。
CANVAS_ROLE=student

# 日期时间显示所用的时区。
TIMEZONE=America/Los_Angeles

# ---------------------------------------------------------------------------
# 写入类工具（运维者上限 + 学生写入开关）
# ---------------------------------------------------------------------------

# 运维者上限：all = 允许全部 Canvas 写入工具（代码执行类除外，HTTP 下本地写入类仍会被拒绝）。
# 想保持只读，就注释掉这一行和下面的 STUDENT_WRITE_TOOLS。
ALLOWED_WRITE_TOOLS=all

# 注册哪些学生写入工具（空 = 一个都不开）。下面是全部 11 个：
STUDENT_WRITE_TOOLS=submit_assignment,comment_on_my_submission,mark_module_item_done,create_planner_note,update_planner_note,delete_planner_note,mark_planner_item_complete,create_personal_calendar_event,delete_personal_calendar_event,send_message,reply_to_conversation

# 没有任课教师设置策略的课程，学生写入默认被拒绝（deny）。
# 写 allow 才能在这类课程里使用上面开启的写入工具；教师若明确写了
# agent_writes: deny，仍然会被遵守。
# 风险提示：allow 意味着 AI 代理可以在这些课程里提交作业、发消息；Canvas 页面里
# 同学或老师写的内容可能夹带提示词注入。只信任的小圈子才建议用 allow，
# 并在 claude.ai 里把写入工具设为「Ask before using」（见 README.md）。
COURSE_AGENT_POLICY_DEFAULT=allow

# ---------------------------------------------------------------------------
# 结果大小与审计
# ---------------------------------------------------------------------------

# 单个工具结果的最大字符数，仅对 claude.ai 生效（Claude Code 不截断）。0 = 不限制。
MCP_MAX_RESULT_CHARS=140000

# 审计日志目录（镜像默认 /data/audit）；设为 true 还会记录访问事件。
# 多用户模式下每条事件带 principal=entra:<租户ID>:<对象ID>（只含 GUID，无姓名或邮箱）。
# LOG_ACCESS_EVENTS=true

# 数据匿名化：镜像默认开启（true），改动前请先评估隐私影响。
# ENABLE_DATA_ANONYMIZATION=true

# ---------------------------------------------------------------------------
# 持久化目录（镜像已设置，通常不用改）
# ---------------------------------------------------------------------------

# 必填，但镜像已经默认设置，这里写出来只是为了明确：
# FastMCP 的 OAuth 代理状态保存在这里，必须是可写的绝对路径（在 /data 数据卷内）。
FASTMCP_HOME=/data/fastmcp

# Canvas token 库位于 <SELFHOST_DATA_DIR>/canvas-mcp/tokens.sqlite3。
# SELFHOST_DATA_DIR=/data

# ---------------------------------------------------------------------------
# 以下变量在多用户模式下「必须保持未设置」，设置了服务会拒绝启动。
# 它们只在注释里出现，请不要取消注释：
#
#   CANVAS_API_TOKEN          不能有服务器级别的 Canvas token，每个用户用自己的
#   MCP_ACCESS_KEYS           旧的访问密钥模式
#   ENTRA_AUTH_ENABLED        旧的 Azure Easy Auth 模式（头信息可伪造）
#   MCP_ALLOW_UNAUTHENTICATED 允许匿名访问
#   ACCESS_REQUEST_ENABLED    旧的访问申请流程
#   EXECUTE_TYPESCRIPT_ENABLED=true   代码执行不能在共享主机上以用户 token 运行
#                                     （ALLOWED_WRITE_TOOLS 里也不能出现 execute_typescript）
# ---------------------------------------------------------------------------
