# canvas-mcp self-hosted (Entra, multi-user) configuration template.
#
#   curl -fsSL https://raw.githubusercontent.com/KKazuhaK/canvas-mcp/uci-student/deploy/selfhost/env.example -o .env
#   chmod 600 .env        # contains secrets: keep it readable by you only; never commit it to git
#
# Settings marked "Required." must be filled in. If one is missing or malformed, the
# server refuses to start (fail closed).
# Do not quote values, do not put spaces around the equals sign, and do not add
# trailing comments on the same line.
# The command to generate each random secret is written next to it
# (openssl rand -base64 48 / 32).

# ---------------------------------------------------------------------------
# Mode switch
# ---------------------------------------------------------------------------

# Required. Must be exactly entra-oauth to enable multi-user mode (when unset, the
# old single-user behavior applies).
MCP_AUTH_MODE=entra-oauth

# Required. The public address of the service: https, with no path, query string or
# trailing slash, for example
#   https://canvas.example.com
# It is also the OAuth issuer, the MCP resource (<address>/mcp), the only allowed
# Host / Origin, and the prefix of the Entra redirect URIs. It is left blank on
# purpose: if you forget to fill it in, the server refuses to start instead of
# running with somebody else's domain.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD): one app registration is used for both MCP sign-in and /account sign-in
# ---------------------------------------------------------------------------

# Required. Directory (tenant) ID, a GUID. common / organizations / consumers are not allowed.
ENTRA_TENANT_ID=

# Required. Application (client) ID, a GUID.
ENTRA_CLIENT_ID=

# Required. The client secret "Value" (not the "Secret ID"), at least 16 characters.
# When it expires, create a new one in Entra and replace it; only a restart is needed
# and users are not affected.
ENTRA_CLIENT_SECRET=

# Name of the delegated scope created under "Expose an API" (api://<client-id>/Canvas.Access). The default is fine.
# ENTRA_API_SCOPE=Canvas.Access

# App role that grants access: assign it to the group of trusted users. The default is fine.
# ENTRA_REQUIRED_ROLE=Canvas.User

# Operator role: has access as well, and can open /account/admin to view enrollments, disable and enable users, and remove stored tokens. Must differ from the role above.
# ENTRA_OWNER_ROLE=Canvas.Owner

# Who may use the server, and who is an owner. The defaults reproduce the two app roles above,
# so an existing deployment needs none of the settings in this block. See README.md "Accounts and admission".
#
# ACCESS_POLICY decides what happens to a person nobody has seen before:
#   rules     (default) only people that ACCESS_RULES admit get an account; everybody else is refused
#   approval  everybody gets an account, but it waits until an owner approves it at /account/admin
#   open      everybody the Entra tenant signs in gets an account at once (the tenant is still checked)
# ACCESS_POLICY=rules

# With ACCESS_POLICY=rules: comma-separated rules, each provider:kind:value. Any one match admits.
#   entra:role:<app role value>      the role is in the token's roles claim
#   entra:group:<group object id>    the group is in the token's groups claim (a groups overage never matches).
#                                    The app registration must emit it: set groupMembershipClaims to SecurityGroup
#                                    or, better, ApplicationGroup in the manifest so both tokens carry groups.
#   entra:tenant:<tenant id>         the token comes from this tenant (must be ENTRA_TENANT_ID)
# Unset means entra:role:<ENTRA_REQUIRED_ROLE>. Anything else (an unknown kind, or a google:, github:
# or oidc: rule) stops the server at startup.
# ACCESS_RULES=entra:role:Canvas.User

# With ACCESS_POLICY=rules: what happens to a person no rule admits. deny (default) refuses them;
# approval creates a pending account for an owner to decide on.
# ACCESS_FALLBACK=deny

# Who is an owner: comma-separated rules in the same grammar, or "none". Unset means
# entra:role:<ENTRA_OWNER_ROLE>. An owner role is taken at sign-in and lost with the rule, except that
# the last active owner is never demoted.
# OWNER_RULES=entra:role:Canvas.Owner

# Optional: make one person an owner the first time they sign in, but only while the server has no
# active owner. Form: entra:<tenant id>:<object id> (both GUIDs, the tenant must be ENTRA_TENANT_ID).
# SELFHOST_BOOTSTRAP_OWNER=

# Reserved for login providers that anyone on the internet can use; unused while Entra is the only one.
# ACCESS_OPEN_ACKNOWLEDGE_PUBLIC=false

# Reserved and not implemented: the server refuses to start if this is set. Sign-in history records
# the client address as "unknown" until a trusted-proxy mode exists.
# TRUSTED_PROXY_CIDRS=

# Callback URIs that MCP clients (claude.ai, Claude Code) may use, comma-separated.
# The defaults are below and usually need no change: https addresses (not local), or
# http on localhost / 127.0.0.1 (omit the port; any port matches).
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost/callback,http://127.0.0.1/callback

# ---------------------------------------------------------------------------
# Secrets (all must be randomly generated; do not reuse them)
# ---------------------------------------------------------------------------

# Required. Signing key for the tokens issued to claude.ai / Claude Code, at least 32 characters.
# Generate: openssl rand -base64 48
# After changing it, every MCP client has to reconnect.
OAUTH_JWT_SIGNING_KEY=

# Required. Encryption key for the /account session cookie, base64, at least 32 bytes once decoded.
# Generate: openssl rand -base64 32
# After changing it, only the /account sign-in sessions are invalidated.
ACCOUNT_SESSION_SECRET=

# Absolute lifetime of an /account sign-in session in seconds, 60 to 3600, default 900 (15 minutes). It is never renewed automatically.
# ACCOUNT_SESSION_TTL_SECONDS=900

# Required. Key ring that encrypts Canvas tokens: kid:base64key[,kid2:base64key].
# A kid may contain only letters, digits, underscores and hyphens (at most 32 characters); each key must be exactly 32 bytes once decoded.
# The first entry encrypts new data; every entry can decrypt. Generate:
#   echo "k1:$(openssl rand -base64 32)"
# Losing it means every user has to enroll their Canvas token again. See README.md for the rotation steps.
CANVAS_TOKEN_KEYS=

# ---------------------------------------------------------------------------
# Canvas
# ---------------------------------------------------------------------------

# Required. It may be left empty only if CANVAS_FEATURED_SCHOOLS or
# CANVAS_SCHOOL_SEARCH=true is set below.
# The Canvas address; it must be https, for example https://canvas.school.edu
# Left blank on purpose: if you forget to fill it in, the server refuses to start instead of pointing at someone else's Canvas.
# On its own, all users are pinned to this one Canvas (the single-school behavior).
# Together with either option below it becomes the default school: it is always offered
# as a quick pick, and enrollments that were saved before schools existed belong to it.
CANVAS_API_URL=

# Optional: school quick picks for /account, so each user can choose their own Canvas.
# Comma-separated entries, each 'host' or 'host=Display Name'. Host names only (no https://,
# port or path); the name is optional and shown in the picker. With only one school and
# search off there is no picker.
# CANVAS_FEATURED_SCHOOLS=canvas.example.edu=Example University,canvas.other.example.edu

# Optional: let a signed-in user search Instructure's public school directory (the one the
# Canvas mobile app uses) for a school that is not listed above. The server accepts a chosen
# host only after the directory confirms that exact domain, then refuses names that resolve
# to private or internal addresses. Privacy: the search terms are sent to Instructure, and
# enrolling needs outbound HTTPS to canvas.instructure.com as well as to the school.
# Turning it off again signs out everyone whose school came from a search.
# If CANVAS_API_URL is empty, one of CANVAS_FEATURED_SCHOOLS or this setting must be set.
# CANVAS_SCHOOL_SEARCH=true

# Toolset: student is recommended for student accounts.
CANVAS_ROLE=student

# Time zone used when displaying dates and times.
TIMEZONE=America/Los_Angeles

# What the server remembers between one request and the next about a user's courses:
#   request_local  (default) Nothing is kept. Every request resolves course names, course policies and
#                  discussion hints, and builds its anonymization pseudonyms, with that user's own Canvas
#                  token, and drops them when the request ends. The course list and aliases then work as in
#                  the upstream HTTP modes; policies, pseudonyms and hints are stricter than upstream, which
#                  keeps them in process-wide maps shared by all callers (keyed only by course, user or topic id).
#                  It costs an extra course-list read on requests that name a course by code or title.
#   per_principal  Keep them in memory for the same user across requests (fewer Canvas calls). Each entry is
#                  keyed by the user, the school and the credential generation and is dropped when the user's
#                  token changes, but more per-user data stays in the process. Opt in only after measuring
#                  that the extra Canvas requests matter. See "Course state" in README.md.
# SELFHOST_COURSE_STATE=request_local

# Optional: remove tools from this server at startup, whatever they do (read or write).
# A comma-separated list of tool names, for example to switch off file text extraction on a
# small host: SELFHOST_DISABLED_TOOLS=read_course_file_text,read_course_file
# A named tool is not listed and cannot be called by anyone; the server refuses to start if a
# name is not a tool it knows (a typo would otherwise leave the tool on). This setting can only
# remove tools: it never adds one, and it does not change ALLOWED_WRITE_TOOLS or any user's own
# write-tool switches. A name that is already absent (another CANVAS_ROLE, or not allowed) is
# fine. Unset or empty = remove nothing. --config shows the list. See "Disabling tools" in README.md.
# SELFHOST_DISABLED_TOOLS=

# ---------------------------------------------------------------------------
# Write tools (all off by default = read-only)
# ---------------------------------------------------------------------------

# This template is read-only by default: the three settings below are comments, and
# no write tool exists unless you uncomment them.
#
# Risk warning (read it fully before deciding whether to enable them): this is a public
# multi-user server. The Canvas content the AI reads (classmates' discussion replies,
# instructors' announcements, course pages) can be written by other people and may carry
# prompt injection; the model itself can also complete the two-step "preview -> confirmation
# token" flow that the tools provide; and the server cannot force every user to set the
# write tools to "Ask before using" in claude.ai. So the secure setup has to be
# opt-in, not "forgot to turn it off". See "Prompt-injection risk of write tools" in README.md.
#
# Even when you enable tools below, they stay off for every user until that user turns
# each one on for themselves in the "Write tools" section of /account. The settings here
# are only the server's ceiling. See "Write tools: each user opts in" in README.md.
#
# If you really need them, uncomment and keep only the tools you need (especially
# submit_assignment, send_message and reply_to_conversation; avoid enabling them unless necessary):
#
# Operator ceiling: all = allow every Canvas write tool (except code-execution tools; local-write tools are still refused over HTTP).
# ALLOWED_WRITE_TOOLS=all
#
# Which student write tools to register (empty = none). All 11 are listed below:
# STUDENT_WRITE_TOOLS=submit_assignment,comment_on_my_submission,mark_module_item_done,create_planner_note,update_planner_note,delete_planner_note,mark_planner_item_complete,create_personal_calendar_event,delete_personal_calendar_event,send_message,reply_to_conversation
#
# For courses where no instructor has set a policy, student writes are refused by
# default (deny, which is also the value when this is unset).
# Set allow to use the write tools enabled above in such courses; if an instructor
# explicitly wrote agent_writes: deny, that is still honored. allow means the AI agent
# can submit assignments and send messages in those courses, so use it only for a small
# circle you trust.
# COURSE_AGENT_POLICY_DEFAULT=allow

# ---------------------------------------------------------------------------
# Result size and audit
# ---------------------------------------------------------------------------

# Maximum characters in a single tool result; applies to claude.ai only (Claude Code does not truncate). 0 = unlimited.
MCP_MAX_RESULT_CHARS=140000

# The audit log is off by default: when neither setting below is set (or both are false),
# no audit events are produced and no audit directory is created (the image default is
# /data/audit; change it with AUDIT_LOG_DIR).
# Set true to record data-access events (LOG_EXECUTION_EVENTS records code-execution
# events; code execution is disabled in this mode, so it is not needed).
# In multi-user mode every event carries principal=entra:<tenant-id>:<object-id>
# (GUIDs only, no names or email addresses).
# Note: enrolling, replacing or deleting a Canvas token on the /account page does not write an audit log entry at the moment.
# LOG_ACCESS_EVENTS=true

# Data anonymization: on by default in the image (true); assess the privacy impact before changing it.
# ENABLE_DATA_ANONYMIZATION=true

# ---------------------------------------------------------------------------
# Persistent directories (set by the image; usually no change needed)
# ---------------------------------------------------------------------------

# Required. The image already sets it by default; it is written out here only to be explicit.
# FastMCP stores its OAuth proxy state here. It must be a writable absolute path (inside the /data volume).
FASTMCP_HOME=/data/fastmcp

# The Canvas token store is at <SELFHOST_DATA_DIR>/canvas-mcp/tokens.sqlite3
# (unless DATABASE_URL below selects PostgreSQL).
# SELFHOST_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Database (optional; the default needs no setting)
# ---------------------------------------------------------------------------

# Where the encrypted Canvas tokens, the access decisions (disabled users, owners and
# their history), the per-user write-tool switches and the credential generations live.
# Unset = SQLite, the file named above. Nothing to configure and nothing to change for an
# existing deployment.
# For PostgreSQL use a psycopg 3 URL (the postgresql+psycopg scheme is required; special
# characters in the password must be percent-encoded, or use only letters and digits, for
# example the output of: openssl rand -hex 32):
#   postgresql+psycopg://canvas:<password>@postgres:5432/canvas_mcp
# Allowed query parameters: sslmode, sslrootcert, sslcert, sslkey, connect_timeout,
# application_name. For a database on another host use ?sslmode=verify-full. Use a direct
# connection, not pgbouncer (migrations take a session-level lock).
# The URL is never logged or printed with its user name, password or query.
# Switching an existing SQLite deployment: do not just set this. The server refuses to
# start on an empty PostgreSQL database while the SQLite file still holds data; import it
# first (README.md, "Database").
# DATABASE_URL=

# Apply schema changes automatically at start-up (default true). This is safe because the
# server is one process, and concurrent starters are serialised by a lock. Set false to
# make the server refuse a database that is not current, and run
# `python -m canvas_mcp.core.selfhost.token_admin db upgrade` yourself (after a backup).
# DATABASE_AUTO_MIGRATE=true

# A SQLite DATABASE_URL must point inside SELFHOST_DATA_DIR unless this is true.
# DATABASE_ALLOW_SQLITE_OUTSIDE_DATA_DIR=false

# Only for docker-compose.postgres.yml (the optional PostgreSQL service): its password.
# Put the same value in DATABASE_URL. Required if you use that file; generate: openssl rand -hex 32
# POSTGRES_PASSWORD=

# Where short-lived state lives (rate-limit counters, one-time login state). Only memory
# (inside the one server process) exists, which is correct for a single instance.
# "redis" is reserved for a future multi-instance mode and is NOT implemented: setting it
# makes the server refuse to start.
# SELFHOST_STATE_BACKEND=memory

# ---------------------------------------------------------------------------
# The variables below "must stay unset" in multi-user mode; if they are set, the
# server refuses to start. They appear in comments only, so do not uncomment them:
#
#   CANVAS_API_TOKEN          no server-level Canvas token; every user uses their own
#   MCP_ACCESS_KEYS           the old access-key mode
#   ENTRA_AUTH_ENABLED        the old Azure Easy Auth mode (headers can be forged)
#   MCP_ALLOW_UNAUTHENTICATED allow anonymous access
#   ACCESS_REQUEST_ENABLED    the old access-request flow
#   EXECUTE_TYPESCRIPT_ENABLED=true   code execution must not run with users' tokens on a shared host
#                                     (execute_typescript also must not appear in ALLOWED_WRITE_TOOLS)
#   FASTMCP_SSRF_TRUST_PROXY  FastMCP setting that hands the DNS and private-address checks on
#                             OAuth client-metadata and key fetches to an outbound proxy and turns
#                             them off in FastMCP; any value except an explicit false is refused
# ---------------------------------------------------------------------------
