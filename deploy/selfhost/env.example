# Save as .env beside docker-compose.yml. Only the public address is required.
# Start: docker compose up -d
# Open PUBLIC_BASE_URL/account/setup and use the code from docker compose logs.
# Create the local administrator there; optional external login apps are database-managed.
PUBLIC_BASE_URL=

# Leave empty for SQLite in the persistent data volume.
# For an existing PostgreSQL server, use a container-reachable address:
# DATABASE_URL=postgresql+psycopg://user:password@database:5432/canvas_mcp
DATABASE_URL=

# Optional. The Compose default is the beta channel.
# CANVAS_MCP_IMAGE=ghcr.io/kkazuhak/canvas-mcp:beta
# First-install setup supports local accounts and optional external login providers.
# The server is read-only and anonymized by default.
# Internal keys are generated once in the persistent canvas-mcp-data volume.
# Keep this .env private. Preserve the data volume when recreating containers.
