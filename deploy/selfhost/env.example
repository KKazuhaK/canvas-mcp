# Save as .env beside docker-compose.yml. Only the public address is required.
# Start: docker compose up -d
# Open PUBLIC_BASE_URL/account/setup and use the code from docker compose logs.
# Enter login application credentials on that page; they are saved in the database.
PUBLIC_BASE_URL=

# Optional. The Compose default is the beta channel.
# CANVAS_MCP_IMAGE=ghcr.io/kkazuhak/canvas-mcp:beta
# First-install setup configures Entra; the server is read-only and anonymized.
# Internal keys are generated once in the persistent canvas-mcp-data volume.
# Keep this .env private. Preserve the data volume when recreating containers.
