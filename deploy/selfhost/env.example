# Save this file as .env beside docker-compose.yml. Fill in the four values below.
# Start: docker compose up -d
# Entra: single-tenant Web application; callback PUBLIC_BASE_URL/auth/callback/entra.
# Assign Canvas.Owner to the owner and Canvas.User to admitted guests.
# Client secret: use the Value column, not the Secret ID.
PUBLIC_BASE_URL=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional. The Compose default is the beta channel.
# CANVAS_MCP_IMAGE=ghcr.io/kkazuhak/canvas-mcp:beta
# Login defaults to Entra; the server is read-only and anonymized.
# Internal keys are generated once in the persistent canvas-mcp-data volume.
# Keep this .env private. Preserve the data volume when recreating containers.
