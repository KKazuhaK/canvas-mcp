# Add only this exact location to the existing Hub HTTPS virtual host.
# This forwards to the separate Canvas service, not to MCPHub.
# Adjust the loopback port if the existing Canvas container publishes another one.
location = /canvas-hub/authorize {
    proxy_pass http://127.0.0.1:8819;
    proxy_set_header Host $host;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Origin $http_origin;
    proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
    # Browser bearer keys and forwarded identity headers have no role in this flow.
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-User "";
    proxy_set_header X-Forwarded-Email "";
    proxy_set_header X-Auth-Request-User "";
    proxy_set_header X-Auth-Request-Email "";
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    add_header Cache-Control "no-store" always;
    client_max_body_size 2k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    access_log off;
    # Do not put request lines or cookie headers in a debug/error log.
    error_log /dev/null crit;
}
