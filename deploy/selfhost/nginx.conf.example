# nginx reverse proxy example: canvas.mcp.kazuhahub.com -> 127.0.0.1:8819
# Replace the certificate paths with your own (certbot / acme.sh / a Cloudflare Origin certificate all work).
# Put this file in conf.d/ or sites-enabled/ (it is included inside the http block),
# so the limit_req_zone at the top can sit at the top level of the file.

# Rate limiting: /register (dynamic client registration) and /authorize need no sign-in,
# anyone can call them, and every call writes a file to the data volume. The service has
# its own process-wide limit as a backstop, but it cannot tell source IPs apart (uvicorn
# does not trust X-Forwarded-*), so the per-IP limit has to be done here.
# If Cloudflare is in front, $binary_remote_addr is a Cloudflare address:
# either restore the real IP first with ngx_http_realip_module
# (set_real_ip_from + real_ip_header CF-Connecting-IP), or use a Cloudflare
# rate-limiting rule instead (see the README).
limit_req_zone $binary_remote_addr zone=canvas_oauth:10m rate=10r/m;

# SELFHOST_AUTH_MODE=local only: /token (code exchange and every token refresh) and /revoke are
# called by the MCP clients themselves, so they get a higher per-IP limit than the entry points
# above. claude.ai refreshes all come from Anthropic's shared egress range 160.79.104.0/21, so
# counting that range per IP would throttle every claude.ai user at once: the geo/map pair below
# leaves it out (an empty key is not counted). Delete both blocks to count it like anyone else.
# Behind Cloudflare, restore the real client IP first (see above), or $binary_remote_addr
# is a Cloudflare address.
geo $canvas_token_exempt {
    default            0;
    160.79.104.0/21    1;
}
map $canvas_token_exempt $canvas_token_key {
    0    $binary_remote_addr;
    1    "";
}
limit_req_zone $canvas_token_key zone=canvas_token:10m rate=120r/m;
limit_req_status 429;

# Logging: the default `combined` format writes the whole request line, and the OAuth
# redirects carry one-time values in it (/authorize?...&state=..., /auth/callback?code=..&state=..,
# and with SELFHOST_AUTH_MODE=local the request id in /account/login?txn=.. and /account/consent?txn=..).
# Log the path only ($uri has no query string) and never the Authorization header or cookies.
# nginx still writes the request line into error_log when an upstream error happens: keep that
# log at `error` level, readable by root only, with short retention.
log_format canvas_safe '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name canvas.mcp.kazuhahub.com;

    # If ACME validation uses HTTP-01, add a location /.well-known/acme-challenge/ here
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # The standalone `http2 on;` directive exists only in nginx 1.25.1 and later. Older
    # nginx (for example the 1.18 shipped with Ubuntu 22.04) fails with unknown directive
    # "http2": delete the line below and change the two listen lines above to
    # `listen 443 ssl http2;` and `listen [::]:443 ssl http2;`.
    # HTTP/2 is not required; if you do not want the hassle, just delete the line.
    http2 on;
    server_name canvas.mcp.kazuhahub.com;

    access_log /var/log/nginx/canvas-mcp.access.log canvas_safe;
    error_log  /var/log/nginx/canvas-mcp.error.log error;

    ssl_certificate     /etc/letsencrypt/live/canvas.mcp.kazuhahub.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/canvas.mcp.kazuhahub.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # claude.ai MCP request bodies and the /account forms are tiny; 10m is more than enough.
    client_max_body_size 10m;

    # The two OAuth entry points that need no sign-in: 10 requests per minute per IP (burst of 5).
    # In normal use they are rarely called: they run only once when a connector is connected.
    location = /register {
        limit_req zone=canvas_oauth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8819;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 16k;
    }

    # SELFHOST_AUTH_MODE=local: the token endpoint and the revocation endpoint. Bodies are tiny
    # (the service refuses more than 16 KiB itself). They do not exist in entra_proxy mode, where
    # /token is FastMCP's and /revoke answers 404; the block is harmless there.
    location = /token {
        limit_req zone=canvas_token burst=60 nodelay;
        proxy_pass http://127.0.0.1:8819;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 16k;
    }

    location = /revoke {
        limit_req zone=canvas_token burst=60 nodelay;
        proxy_pass http://127.0.0.1:8819;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 16k;
    }

    location = /authorize {
        limit_req zone=canvas_oauth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8819;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8819;
        proxy_http_version 1.1;

        # The service allows only the Host of PUBLIC_BASE_URL; forward it unchanged, otherwise you get 421.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MCP uses streaming responses (SSE): do not buffer and do not cache.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
