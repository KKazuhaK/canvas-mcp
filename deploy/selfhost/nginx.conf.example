# nginx 反向代理示例：canvas.mcp.kazuhahub.com -> 127.0.0.1:8819
# 把证书路径换成你自己的（certbot / acme.sh / Cloudflare Origin 证书都可以）。

server {
    listen 80;
    listen [::]:80;
    server_name canvas.mcp.kazuhahub.com;

    # ACME 验证若走 HTTP-01，请在这里加 location /.well-known/acme-challenge/
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name canvas.mcp.kazuhahub.com;

    ssl_certificate     /etc/letsencrypt/live/canvas.mcp.kazuhahub.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/canvas.mcp.kazuhahub.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # claude.ai 的 MCP 请求体和 /account 表单都很小；10m 绰绰有余。
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8819;
        proxy_http_version 1.1;

        # 服务只放行 PUBLIC_BASE_URL 的 Host，必须原样转发，否则会 421。
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MCP 使用流式响应（SSE）：不能缓冲、不能缓存。
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
