# Caddy 反向代理示例：自动申请并续期 TLS 证书，Host 头默认原样转发。
#
# 限流：/register（动态客户端注册）和 /authorize 不需要登录，每次调用都会往数据卷
# 写文件。服务自己有一个全进程的限流兜底，但分不清来源 IP，所以按 IP 的限流要放在
# 代理这一层。标准版 Caddy 不带限流模块，两种办法选一个：
#   1. 用 xcaddy 编译带 github.com/mholt/caddy-ratelimit 的 Caddy，然后启用下面
#      注释掉的 rate_limit 块；
#   2. 在 Cloudflare 里给 /register 和 /authorize 加速率限制规则（见 README）。
# 启用第 1 种办法时，还要在 Caddyfile 最顶部加全局选项（指令顺序）：
#   {
#   	order rate_limit before basic_auth
#   }
# 若前面有 Cloudflare，{remote_host} 是 Cloudflare 的地址：用 trusted_proxies 配合
# {client_ip} 还原真实 IP，或者直接用第 2 种办法。
canvas.mcp.kazuhahub.com {
	# 需要 caddy-ratelimit 模块；没有这个模块时 Caddy 会因为未知指令而拒绝加载，
	# 所以默认保持注释。
	# @oauth_open path /register /authorize
	# rate_limit @oauth_open {
	# 	zone oauth_open {
	# 		key    {remote_host}
	# 		events 10
	# 		window 1m
	# 	}
	# }

	reverse_proxy 127.0.0.1:8819 {
		# MCP 使用流式响应（SSE）：立即刷新，不缓冲。
		flush_interval -1
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
