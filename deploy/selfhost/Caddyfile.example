# Caddy reverse proxy example: TLS certificates are obtained and renewed automatically, and the Host header is forwarded unchanged by default.
#
# Rate limiting: /register (dynamic client registration) and /authorize need no sign-in,
# and every call writes a file to the data volume. The service has a process-wide limit
# as a backstop, but it cannot tell source IPs apart, so the per-IP limit belongs in the
# proxy layer. Standard Caddy has no rate-limit module; pick one of two options:
#   1. Build Caddy with xcaddy including github.com/mholt/caddy-ratelimit, then enable
#      the commented-out rate_limit block below;
#   2. Add a rate-limiting rule for /register and /authorize in Cloudflare (see the README).
# If you use option 1, also add a global option (directive order) at the very top of the Caddyfile:
#   {
#   	order rate_limit before basic_auth
#   }
# If Cloudflare is in front, {remote_host} is a Cloudflare address: restore the real IP with
# trusted_proxies together with {client_ip}, or simply use option 2.
#
# Logging: the sign-in flow puts one-time values in URLs (/authorize?...state=...,
# /auth/callback?code=...&state=...). The log block below blanks them, and the headers that
# carry credentials, before anything is written. Keep it when you add log outputs or sinks.
canvas.mcp.kazuhahub.com {
	log {
		output file /var/log/caddy/canvas-mcp.access.log
		format filter {
			wrap json
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace session_state REDACTED
				replace id_token REDACTED
				replace access_token REDACTED
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
			resp_headers>Location delete
		}
	}

	# Requires the caddy-ratelimit module; without it Caddy refuses to load the file
	# because of an unknown directive, so this stays commented out by default.
	# @oauth_open path /register /authorize
	# rate_limit @oauth_open {
	# 	zone oauth_open {
	# 		key    {remote_host}
	# 		events 10
	# 		window 1m
	# 	}
	# }

	reverse_proxy 127.0.0.1:8819 {
		# MCP uses streaming responses (SSE): flush immediately, do not buffer.
		flush_interval -1
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
