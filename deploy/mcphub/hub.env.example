# Keep your existing Hub secrets, authentication and other deployment settings.
# Set absolute host paths. Existing Hub data includes users and encryption keys.
ANTEATER_SOURCE_DIR=/absolute/path/to/anteater-mcp
MCPHUB_DATA_DIR=/absolute/path/to/existing/mcphub-data
# Optional shared upstream key; empty uses anonymous Anteater API quota.
ANTEATER_SHARED_API_KEY=
# Pin reviewed upstream image tags/digests for a production build.
MCPHUB_IMAGE=samanhappy/mcphub:latest
NODE_IMAGE=node:24.21.0-bookworm-slim
