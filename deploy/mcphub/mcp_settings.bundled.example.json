{
  "mcpServers": {
    "canvas-personal": {
      "type": "stdio",
      "owner": "admin",
      "visibility": "public",
      "idleTimeoutMs": 300000,
      "command": "/opt/mcp/canvas-venv/bin/canvas-mcp-server",
      "args": [
        "--transport",
        "stdio",
        "--role",
        "student"
      ],
      "env": {
        "PYTHON_DOTENV_DISABLED": "1",
        "MCP_AUTH_MODE": "legacy",
        "ALLOWED_WRITE_TOOLS": "none",
        "EXECUTE_TYPESCRIPT_ENABLED": "false",
        "ACCESSIBILITY_CHECKERS": "none"
      },
      "credentialTemplate": [
        {
          "target": "env",
          "name": "CANVAS_API_URL",
          "label": "Your Canvas institution URL (https://...)"
        },
        {
          "target": "env",
          "name": "CANVAS_API_TOKEN",
          "label": "Your personal Canvas API token"
        }
      ]
    },
    "anteater-shared": {
      "type": "stdio",
      "owner": "admin",
      "visibility": "public",
      "idleTimeoutMs": 300000,
      "command": "/opt/mcp/bin/node24",
      "args": [
        "/opt/mcp/anteater/anteater-mcp.mjs"
      ],
      "env": {
        "ANTEATER_API_KEY": "${ANTEATER_SHARED_API_KEY}"
      }
    },
    "anteater-personal": {
      "type": "stdio",
      "owner": "admin",
      "visibility": "public",
      "idleTimeoutMs": 300000,
      "command": "/opt/mcp/bin/node24",
      "args": [
        "/opt/mcp/anteater/anteater-mcp.mjs"
      ],
      "credentialTemplate": [
        {
          "target": "env",
          "name": "ANTEATER_API_KEY",
          "label": "Your personal Anteater API secret key"
        }
      ]
    }
  }
}
