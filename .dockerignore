# Git files
.git
.gitignore
.github

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# Environment files (users provide their own), at any depth: a stray one under
# src/ would otherwise be copied into the image.
.env
*.env
**/.env*
**/*.env
**/*.pem
**/*.key

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Testing and development
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Documentation and archives
docs/
archive/

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# Self-hosted image: nothing below is needed to build it, and some of it must
# never reach a build context.
node_modules/
# The React UI builds inside the image from its lock file; a local install or build
# in the context would otherwise be copied over it.
web/node_modules/
web/dist/
verify/
internal/
articles/
skills/
examples/
.claude/
.worktrees/
data/
deploy/selfhost/.env
**/*.sqlite3
uv-cache/
.coverage.*
coverage.xml
coverage/
