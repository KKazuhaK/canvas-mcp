# Self-hosted multi-user image (ghcr.io/kkazuhak/canvas-mcp).
#
# Separate from the root Dockerfile, which is upstream's Azure image and must
# stay as it is. Build with:  docker build -f Dockerfile.selfhost -t canvas-mcp .
#
# Three stages: the web stage builds the React account UI (web/) with Node; the
# build stage installs the locked dependency set and the project (non-editable)
# into /opt/venv; the runtime stage copies only that venv and the built web
# assets, so no uv, pip cache, Node, node_modules or source tree ships. The two
# Python stages use the same digest-pinned base, so the venv's interpreter
# symlink resolves.
#
# The built UI lands in /app/web-dist. Nothing serves it yet: the server still
# renders the legacy /account pages, so runtime behaviour is unchanged.
#
# The image holds NO secrets. Everything sensitive (Entra client secret, JWT
# signing key, session secret, Canvas token keyring) arrives at runtime from
# the operator's .env file.

# Node 24.19.0 on Alpine, pinned by exact tag AND digest (the digest is what is
# pulled; the tag is for humans and for Dependabot). Matches web/package.json
# "engines". Only the build output leaves this stage.
FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS web

WORKDIR /web

# Locked dependencies first (cached until the lock file changes). `npm ci` installs
# exactly what package-lock.json says and fails if it disagrees with package.json;
# --ignore-scripts keeps third-party install scripts from running at all.
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts

# check:dist fails the image build if the dist about to be copied has inline
# scripts, remote URLs, eval or dev-mock code (the CSP / mock-isolation checks).
COPY web/ ./
RUN npm run build && npm run check:dist


FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6 AS build

RUN pip install --no-cache-dir uv==0.12.22

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /src

# Dependencies first (cached until the lock file changes), then the project.
# README.md and LICENSE are read by the build backend for package metadata.
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --extra documents --extra selfhost --extra postgres --no-install-project

COPY src ./src
RUN uv sync --frozen --no-dev --extra documents --extra selfhost --extra postgres --no-editable


FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

# uid/gid 10001, no home directory and no login shell. /data is the only
# writable location (the compose file mounts a named volume there and keeps the
# root filesystem read-only). /data/fastmcp (the OAuth proxy state) exists in the
# image so a separate volume can be mounted there and still be writable.
RUN groupadd --gid 10001 mcp \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin mcp \
    && mkdir /data /data/fastmcp \
    && chown 10001:10001 /data /data/fastmcp \
    && chmod 0700 /data /data/fastmcp

COPY --from=build /opt/venv /opt/venv

# The React account UI (not served yet): static files, root-owned and read-only to
# the service user. See web/README.md.
COPY --from=web /web/dist /app/web-dist

# Non-secret defaults only. Never add a Canvas token, client secret, signing
# key or keyring here; a test (tests/test_selfhost_dockerfile.py) enforces it.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MCP_SERVER_NAME=canvas-mcp \
    ENABLE_DATA_ANONYMIZATION=true \
    EXECUTE_TYPESCRIPT_ENABLED=false \
    FASTMCP_HOME=/data/fastmcp \
    SELFHOST_DATA_DIR=/data \
    AUDIT_LOG_DIR=/data/audit \
    FASTMCP_CHECK_FOR_UPDATES=off \
    FASTMCP_SHOW_SERVER_BANNER=false

USER 10001:10001

VOLUME ["/data"]

EXPOSE 8819

# Any HTTP answer below 500 means the server is up. Entra mode answers /healthz
# with 200; legacy access-key mode has no such route and answers 401, which is
# still a live server (urlopen would raise on it and report a working container
# unhealthy).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import http.client as h;c=h.HTTPConnection('127.0.0.1',8819,timeout=4);c.request('GET','/healthz');assert c.getresponse().status<500"]

# One process, one replica: confirmation tokens, caches and rate limits live in
# process memory.
CMD ["canvas-mcp-server", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8819"]
