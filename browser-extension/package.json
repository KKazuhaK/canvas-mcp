{
  "name": "canvas-mcp-browser-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that pushes read-only Canvas snapshots to your Canvas MCP Portal",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
